{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zanker sandbox component scenarios",
  "type": "array",
  "minItems": 1,
  "maxItems": 30,
  "items": {
    "type": "object",
    "required": [
      "id",
      "props"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "label": {
        "type": "string"
      },
      "props": {
        "type": "object"
      }
    }
  }
}
