{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zanker Design Studio concepts",
  "type": "object",
  "required": [
    "concepts"
  ],
  "properties": {
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "accent": {
            "type": "string"
          },
          "radius": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "css": {
            "type": "string"
          }
        }
      }
    }
  }
}
