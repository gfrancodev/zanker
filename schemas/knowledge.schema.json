{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zanker.local/schemas/knowledge.schema.json",
  "title": "Zanker Knowledge Pack",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "principles",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "antiPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url"
              ]
            }
          }
        }
      }
    }
  }
}
